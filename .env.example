# API Base Endpoint configuration (Edura Nginx gateway)
NEXT_PUBLIC_API_URL=http://localhost

# Application
NEXT_PUBLIC_APP_NAME=Edura

# Google Sign-In (OAuth 2.0 Client ID, "Web application" type, from Google Cloud
# Console > APIs & Services > Credentials). No client secret needed here —
# auth_service verifies the token directly against Google's userinfo endpoint.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
